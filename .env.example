# Copia este archivo a .env (no se sube a git).
# Cualquier clave de config.yaml se puede sobreescribir con CLIP__SECCION__CLAVE.
# Ejemplos:
# CLIP__RENDER__ENCODER=libx264
# CLIP__TRANSCRIPCION__MODELO=small
# CLIP__PROYECTOS_DIR=D:/clips/proyectos

# Ruta a un config alternativo
# CLIP_CONFIG=config.yaml

# Cookies de navegador para yt-dlp (contenido propio/privado). NO subir a git.
# YTDLP_COOKIES=C:/ruta/cookies.txt
